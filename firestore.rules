rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Patents and presentations: anyone can read (the public site needs
    // this), but only a signed-in user can create, edit, or delete. Since
    // this project only creates accounts manually in the Firebase console
    // for your client (no public sign-up is wired up), "signed in" and
    // "your client" are effectively the same thing.
    match /patents/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /presentations/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
